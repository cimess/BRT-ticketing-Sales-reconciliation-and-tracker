# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Local Database backups and SQL dumps
*.sql
*.sql.gz
*.sql.tar
*.dump
*.db
*.sqlite
*.sqlite3
# DuckDB persistent caches & temp files
*.duckdb
*.duckdb.tmp
.duckdb/
# Key files, credentials & certificates
*.key
credentials.json
service-account*.json
r2-credentials.json
# Local IDE configuration overrides (optional, prevents leaking absolute local paths)
.vscode/settings.json
.vscode/tasks.json
.vscode/launch.json
