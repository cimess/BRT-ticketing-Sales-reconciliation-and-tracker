generator client {
  provider = "prisma-client-js"

}

datasource db {
  provider = "postgresql"
}


model Company {
  id                      String                  @id @default(cuid())
  name                    String                  @unique
  code                    String                  @unique // e.g., "BRT", "LCC"
  createdAt               DateTime                @default(now())
  updatedAt               DateTime                @updatedAt

  // Relations
  users                   User[]
  registration_tokens     RegistrationToken[]
  company_floats          CompanyFloat[]
  float_allocations       Float_allocations[]
  remittances             Remittance[]
  remittance_expectations RemittanceExpectation[]
  float_ledgers           Float_Ledger[]
  pos_devices             Pos_devices[]
  sales_reports           SalesReport[]
  commission_earnings     CommissionEarning[]
  fines                   Fine[]
  locations               Location[]
  top_ups                 TopUp[]
  reconciliation_reports  Reconciliation_reports[]
  audit_logs              AuditLog[]
  pos_device_sessions     PosDeviceSession[]
  commission_rules        Commission_rules[]
  ticketer_location_assignments Ticketer_Location_Assignment[]
  company_rules           CompanyRule[]
  
}

model User {
  id                   String              @id @default(cuid())
  company_id           String
  first_name            String
  last_name             String
  address              String?
  guarantor_name        String?
  guarantor_phone      String?
  guarantor_address     String?
  email                String              
  phone                String ?             
  password             String
  role                 Roles               @default(TICKETER)
  restricted           Boolean             @default(false)
  supervisor_id        String?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  isVerified           Boolean             @default(false)
  verificationToken    String?
  verificationTokenExpires DateTime?


  audit_logs           AuditLog[]
  commission_earnings  CommissionEarning[]
  fines_issued         Fine[]              @relation("FineIssuer")
  fines                Fine[]              @relation("FineReceiver")
  allocations_given    Float_allocations[] @relation("AllocationFrom")
  pos_sessions         PosDeviceSession[]
  remittances          Remittance[]
  sales_reports        SalesReport[]
  supervisor           User?               @relation("SupervisorTicketers", fields: [supervisor_id], references: [id])
  ticketers            User[]              @relation("SupervisorTicketers")
  //the admin who issued the token
  tokens_issued        RegistrationToken[] @relation("AdminTokensIssued")
  ticket_assignments   Ticketer_Location_Assignment[] @relation("TicketerAssignment")

  received_remittances Remittance[] @relation("SupervisorRemittances")
  remittance_expectations RemittanceExpectation[]
  company              Company             @relation(fields: [company_id], references: [id])
  @@unique([email, company_id])

  created_assignments  Ticketer_Location_Assignment[] @relation("AssignmentCreator")

}
model RegistrationToken {
  id          String   @id @default(cuid())
  company_id           String
  token       String   @unique                 // e.g. "TICKETER-X7B9K"
  role        Roles                            // The role this token grants
  is_used     Boolean  @default(false)         // Becomes true once someone registers with it
  issued_by   String                           // The ID of the Admin who created it
  created_at  DateTime @default(now())
  expires_at  DateTime?                        // Optional: When the token expires
  // Relation mapping back to the Admin who generated it
  issuer      User     @relation("AdminTokensIssued", fields: [issued_by], references: [id])
  company              Company             @relation(fields: [company_id], references: [id])
}

model TopUp{
  id               String       @id @default(cuid())
  amount           Decimal      @db.Decimal(18, 2)
  status           TopUpStatus  @default(AVAILABLE)
  allocated_from   TopUpSource
  allocationNote   String?
  date_received    DateTime     @default(now())
  company_id           String
  company              Company             @relation(fields: [company_id], references: [id])
}

model CompanyFloat{
  company_id           String
  id               String       @id @default("COMPANY_ACCOUNT")
  available_balance Decimal      @db.Decimal(18, 2)
  company              Company             @relation(fields: [company_id], references: [id])
}

model Float_allocations {
  id               String       @id @default(cuid())
  from_user  String
  pos_device_id      String
  amount_allocated Decimal      @db.Decimal(18, 2)
  allocated_at     DateTime     @default(now())
  status           Float_Status @default(SUCCESS)
  company_id           String
  supervisor       User         @relation("AllocationFrom", fields: [from_user], references: [id])
  pos_device       PosDeviceSession       @relation("AllocationTo", fields: [pos_device_id], references: [id])
  company              Company             @relation(fields: [company_id], references: [id])
}


model Remittance {
  id                String            @id @default(cuid())
  submitted_by       String
  verified_by        String?
  amount            Decimal      @db.Decimal(18, 2)
  method            Remittance_Method
  payment_reference String?
  remittance_date   DateTime
  status            RemittanceStatus  @default(PENDING)
  created_at        DateTime          @default(now())
  verified_at       DateTime?
  pos_session_id    String?
  received_by_supervisor_id String?
  company_id           String
  supervisor_receiver       User?   @relation("SupervisorRemittances", fields: [received_by_supervisor_id], references: [id])

  //the user who submitted the remittance
  ticketer          User              @relation(fields: [submitted_by], references: [id])
  company              Company             @relation(fields: [company_id], references: [id])

  pos_session       PosDeviceSession?  @relation(fields: [pos_session_id], references: [id])
}
model Reconciliation_reports {
  id                String       @id @default(cuid())
  user_id           String
  date              DateTime
  expected_float    Decimal      @db.Decimal(18, 2)
  actual_remittance Decimal      @db.Decimal(18, 2)
  variance          Decimal      @db.Decimal(18, 2)
  status            ReconciliationStatus
  scope             ReconciliationScope
  generated_at      DateTime     @default(now())
  company_id           String
  company              Company             @relation(fields: [company_id], references: [id])
}

model RemittanceExpectation {
  id              String @id @default(cuid())


  user_id         String

  pos_session_id  String? @unique

  source_remittance_id  String?

  expected_amount Float

  shortage_amount Float   @default(0)

  due_date              DateTime
  
  extended_due_date     DateTime?

  status          ExpectationStatus

  created_at      DateTime @default(now())
  company_id           String
  
  user              User              @relation(fields: [user_id], references: [id])
  pos_session       PosDeviceSession?  @relation(fields: [pos_session_id], references: [id])
  company              Company             @relation(fields: [company_id], references: [id])
}


model AuditLog {
  id           String   @id @default(cuid())
  user_id      String
  action       AuditAction
  entity_type  AuditEntityType
  entity_id    String
  before_state Json?
  after_state  Json?
  meta         Json?
  created_at   DateTime @default(now())
  company_id           String
  user         User     @relation(fields: [user_id], references: [id])
  company              Company             @relation(fields: [company_id], references: [id])
}

model Float_Ledger {
  id          String     @id @default(cuid())
  account_id  String
  account_type AccountType
  posSession  String?
  amount      Decimal    @db.Decimal(18, 2)
  entry_type  Entry_Type
  reference_type String
  reference_id   String
  description String?
  created_at  DateTime   @default(now())
  company_id           String
  posDevice   PosDeviceSession? @relation("PosDeviceLedger", fields: [posSession], references: [id])
  company              Company             @relation(fields: [company_id], references: [id])
}

model Pos_devices {
  id                String             @id @default(cuid())
  serial_number     String             @unique
  name              String             
  status            Device_Status      @default(INACTIVE)
  created_at        DateTime           @default(now())
  company_id           String
  device_assignment PosDeviceSession[]
  company              Company             @relation(fields: [company_id], references: [id])
  @@unique([name, company_id])
}

model PosDeviceSession {
  id                String            @id @default(cuid())
  device_id         String
  user_id           String
  pos_float         Decimal           @db.Decimal(18, 2)
  assigned_at       DateTime          @default(now())
  unassigned_at     DateTime?
  assigned_by       String
  unassigned_by     String?
  unassigned_reason String?
  status            Assignment_Status @default(ACTIVE)
  company_id           String
  device            Pos_devices       @relation(fields: [device_id], references: [id])
  user              User              @relation(fields: [user_id], references: [id])
  sales_reports     SalesReport[]
  allocations_given    Float_allocations[] @relation("AllocationTo")
  float_ledger      Float_Ledger[]   @relation("PosDeviceLedger")
  company              Company             @relation(fields: [company_id], references: [id])
  remittance_expectation RemittanceExpectation?
  remittances            Remittance[]
}

model SalesReport {
  id           String           @id @default(cuid())
  ticketer_id  String
  pos_session_id   String
  location_id  String
  opening_balance Float
  closing_balance Float
  total_sold   Float
  report_day   DateTime @db.Date
  report_date  DateTime
  submitted_at DateTime         @default(now())
  status          SalesReportStatus @default(PENDING)
  commission_earned Float   @default(0) 
  verified_by     String?
  verified_at     DateTime?
  rejection_reason String?
  company_id           String
  location     Location         @relation(fields: [location_id], references: [id])
  pos_device   PosDeviceSession @relation(fields: [pos_session_id], references: [id])
  ticketer     User             @relation(fields: [ticketer_id], references: [id])
  company              Company             @relation(fields: [company_id], references: [id])
}

model Commission_rules {
  id           String   @id @default(cuid())
  role         Roles
  percentage   Float?
  fixed_amount Decimal?  @db.Decimal(18, 2)
  is_active    Boolean   @default(true)
  created_at   DateTime @default(now())
  company_id           String
  company              Company             @relation(fields: [company_id], references: [id])
}

model CompanyRule {
  id                String   @id @default(cuid())
  name              String   // E.g., "Late Remittance Fine"
  description       String?
  
  // The event context when this rule is checked
  trigger           String   // E.g., "ON_REPORT_SUBMISSION", "ON_SHIFT_VERIFICATION"
  
  // The rule condition details
  target_field      String   // E.g., "shortage_amount", "hours_late_submitting", "total_sold"
  operator          String   // E.g., ">", ">=", "<", "=="
  comparison_value  Float    // The threshold (e.g., 1000 for Naira, 24 for hours)
  
  // The penalty
  fine_amount       Float    // The automatic fine to issue
  
  is_active         Boolean  @default(true)
  created_at        DateTime @default(now())
  
  company_id        String
  company           Company  @relation(fields: [company_id], references: [id])
}


model CommissionEarning {
  id                String       @id @default(cuid())
  user_id           String
  period_start      DateTime
  period_end        DateTime
  total_sales       Float
  commission_amount Float
  fines_deducted    Float
  shortage_deducted  Float        @default(0)
  net_pay           Float
  status            SalaryStatus @default(PENDING)
  created_at        DateTime     @default(now())
  company_id           String
  user              User         @relation(fields: [user_id], references: [id])
  company              Company             @relation(fields: [company_id], references: [id])
}

model Fine {
  id         String      @id @default(cuid())
  defaulter_id    String
  amount     Float?
  reason     String
  issued_by  String
  status     fine_status @default(UNPAID)
  created_at DateTime    @default(now())
  company_id           String
  //the admin/supervisor who issued the fine
  issuer      User        @relation("FineIssuer", fields: [issued_by], references: [id])
  //the user who received the fine
  defaulter       User        @relation("FineReceiver", fields: [defaulter_id], references: [id])
  company              Company             @relation(fields: [company_id], references: [id])
}


model Ticketer_Location_Assignment {
  id            String       @id @default(cuid())
  user_id       String
  location_id   String
  assigned_for  DateTime
  session       Time_Session
  created_by_id String       // The supervisor or admin who made the assignment
  created_at    DateTime     @default(now())
  company_id    String

  user          User         @relation("TicketerAssignment", fields: [user_id], references: [id])
  location      Location     @relation(fields: [location_id], references: [id])
  company       Company      @relation(fields: [company_id], references: [id])
  creator       User         @relation("AssignmentCreator", fields: [created_by_id], references: [id])

  @@unique([user_id, assigned_for, session])
}


model Location {
  id            String        @id @default(cuid())
  name          String
  address       String
  staff_count   Int      @default(1)
  opening_time  String?
  closing_time  String?
  created_at    DateTime      @default(now())
  company_id           String
  sales_reports SalesReport[]
  ticket_assignments Ticketer_Location_Assignment[]
  company              Company             @relation(fields: [company_id], references: [id])
}


enum SalesReportStatus{
  PENDING
  VERIFIED
  REJECTED
  CANCELLED
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  VERIFY
  REVERSE
  CANCELLED
  DEPOSIT
}

enum Time_Session{
  MORNING
  EVENING
}
enum TopUpSource {
  COMPANY_RESERVE
  GOVERNMENT_TOP_UP
  EXTERNAL_OTHER_SOURCE
}

enum AuditEntityType {
  TOPUP
  FLOAT_ALLOCATION
  REMITTANCE
  USER
  FINE
  POS_DEVICE
  SALARY
  SALES_REPORT
  LOCATION
  LOCATION_ASSIGNMENT
  DEPOSIT_CASH
  REMITTANCE_EXPECTATION
}


enum AccountType {
  COMPANY
  TICKETER
  POS_DEVICE
  SUPERVISOR
}

enum Entry_Type {
  DEBIT
  CREDIT
}

enum fine_status {
  UNPAID
  PENDING
  PAID
  WAIVED
}

enum Roles {
  TICKETER
  SUPERVISOR
  ADMIN
  AUDITOR
}

enum Device_Status {
  ACTIVE
  INACTIVE
  MAINTENANCE
}

enum Remittance_Method {
  CASH
  TRANSFER
}

enum RemittanceStatus {
  PENDING_SUPERVISOR_ACCEPTANCE
  ACCEPTED_BY_SUPERVISOR
  REJECTED_BY_SUPERVISOR
  PENDING
  CONFIRMED
  REJECTED
  CANCELLED
  DEPOSITED
}

enum SalaryStatus {
  PENDING
  PAID
}

enum Float_Status {
  SUCCESS
  ADJUSTED
  CANCELLED
}

enum TopUpStatus {
  AVAILABLE
  USED
  CANCELLED
}

enum Assignment_Status {
  ACTIVE
  SHARED
  RETURNED
  CLOSED
}

enum ReconciliationScope {
  TICKETER 
  SUPERVISOR 
  ORG
}

enum ReconciliationStatus {
  MATCHED       
  VARIANCE       
  PENDING        
  INVESTIGATING  
  RESOLVED      
}

enum ExpectationStatus {
  PENDING
  SUBMITTED
  OVERDUE
  VIOLATED
  PAID
}