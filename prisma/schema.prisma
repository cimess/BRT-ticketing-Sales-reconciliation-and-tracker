generator client {
  provider = "prisma-client-js"

}

datasource db {
  provider = "postgresql"
}

model User {
  id                   String              @id @default(cuid())
  first_name            String
  last_name             String
  address              String?
  guarantor_name        String?
  guarantor_phone      String?
  guarantor_address     String?
  email                String              @unique
  phone                String ?             
  password             String
  role                 Roles               @default(TICKETER)
  restricted           Boolean             @default(false)
  supervisor_id        String?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  isVerified           Boolean             @default(false)
  verificationToken    String?
  verificationTokenExpires DateTime?


  audit_logs           AuditLog[]
  commission_earnings  CommissionEarning[]
  fines_issued         Fine[]              @relation("FineIssuer")
  fines                Fine[]              @relation("FineReceiver")
  allocations_given    Float_allocations[] @relation("AllocationFrom")
  pos_sessions         PosDeviceSession[]
  remittances          Remittance[]
  sales_reports        SalesReport[]
  supervisor           User?               @relation("SupervisorTicketers", fields: [supervisor_id], references: [id])
  ticketers            User[]              @relation("SupervisorTicketers")
  //the admin who issued the token
  tokens_issued        RegistrationToken[] @relation("AdminTokensIssued")
  ticket_assignments   Ticketer_Location_Assignment[]
  received_remittances Remittance[] @relation("SupervisorRemittances")
  
}
model RegistrationToken {
  id          String   @id @default(cuid())
  token       String   @unique                 // e.g. "TICKETER-X7B9K"
  role        Roles                            // The role this token grants
  is_used     Boolean  @default(false)         // Becomes true once someone registers with it
  issued_by   String                           // The ID of the Admin who created it
  created_at  DateTime @default(now())
  expires_at  DateTime?                        // Optional: When the token expires
  // Relation mapping back to the Admin who generated it
  issuer      User     @relation("AdminTokensIssued", fields: [issued_by], references: [id])
}

model TopUp{
  id               String       @id @default(cuid())
  amount           Decimal      @db.Decimal(18, 2)
  status           TopUpStatus  @default(AVAILABLE)
  allocated_from   TopUpSource
  allocationNote   String?
  date_received    DateTime     @default(now())
  
}

model CompanyFloat{
  id               String       @id @default("COMPANY_ACCOUNT")
  available_balance Decimal      @db.Decimal(18, 2)
}

model Float_allocations {
  id               String       @id @default(cuid())
  from_user  String
  pos_device_id      String
  amount_allocated Decimal      @db.Decimal(18, 2)
  allocated_at     DateTime     @default(now())
  status           Float_Status @default(SUCCESS)
  supervisor       User         @relation("AllocationFrom", fields: [from_user], references: [id])
  pos_device       PosDeviceSession       @relation("AllocationTo", fields: [pos_device_id], references: [id])
}


model Remittance {
  id                String            @id @default(cuid())
  submitted_by       String
  verified_by        String?
  amount            Decimal      @db.Decimal(18, 2)
  method            Remittance_Method
  payment_reference String?
  remittance_date   DateTime
  status            RemittanceStatus  @default(PENDING)
  created_at        DateTime          @default(now())
  verified_at       DateTime?

  received_by_supervisor_id String?
  supervisor_receiver       User?   @relation("SupervisorRemittances", fields: [received_by_supervisor_id], references: [id])

  //the user who submitted the remittance
  ticketer          User              @relation(fields: [submitted_by], references: [id])
}
model Reconciliation_reports {
  id                String       @id @default(cuid())
  user_id           String
  date              DateTime
  expected_float    Decimal      @db.Decimal(18, 2)
  actual_remittance Decimal      @db.Decimal(18, 2)
  variance          Decimal      @db.Decimal(18, 2)
  status            ReconciliationStatus
  scope             ReconciliationScope
  generated_at      DateTime     @default(now())
}

model RemittanceExpectation {
  id              String @id @default(cuid())

  ticketer_id     String
  allocation_id   String

  expected_amount Float

  due_date        DateTime
  extended_due_date DateTime?

  status          ExpectationStatus // PENDING | SUBMITTED | OVERDUE | VIOLATED

  created_at      DateTime @default(now())
}

model AuditLog {
  id           String   @id @default(cuid())
  user_id      String
  action       AuditAction
  entity_type  AuditEntityType
  entity_id    String
  before_state Json?
  after_state  Json?
  meta         Json?
  created_at   DateTime @default(now())
  user         User     @relation(fields: [user_id], references: [id])
}

model Float_Ledger {
  id          String     @id @default(cuid())
  account_id  String
  account_type AccountType
  posSession  String?
  amount      Decimal    @db.Decimal(18, 2)
  entry_type  Entry_Type
  reference_type String
  reference_id   String
  description String?
  created_at  DateTime   @default(now())
  posDevice   PosDeviceSession? @relation("PosDeviceLedger", fields: [posSession], references: [id])
}

model Pos_devices {
  id                String             @id @default(cuid())
  serial_number     String             @unique
  name              String             @unique
  status            Device_Status      @default(INACTIVE)
  created_at        DateTime           @default(now())
  device_assignment PosDeviceSession[]
}

model PosDeviceSession {
  id                String            @id @default(cuid())
  device_id         String
  user_id           String
  pos_float         Decimal           @db.Decimal(18, 2)
  assigned_at       DateTime          @default(now())
  unassigned_at     DateTime?
  assigned_by       String
  unassigned_by     String?
  unassigned_reason String?
  status            Assignment_Status @default(ACTIVE)
  device            Pos_devices       @relation(fields: [device_id], references: [id])
  user              User              @relation(fields: [user_id], references: [id])
  sales_reports     SalesReport[]
  allocations_given    Float_allocations[] @relation("AllocationTo")
  float_ledger      Float_Ledger[]   @relation("PosDeviceLedger")
}

model SalesReport {
  id           String           @id @default(cuid())
  ticketer_id  String
  user_name    String
  pos_session_id   String
  location_id  String
  opening_balance Float
  closing_balance Float
  total_sold   Float
  report_day   DateTime @db.Date
  report_date  DateTime
  submitted_at DateTime         @default(now())
  location     Location         @relation(fields: [location_id], references: [id])
  pos_device   PosDeviceSession @relation(fields: [pos_session_id], references: [id])
  ticketer     User             @relation(fields: [ticketer_id], references: [id])
}

model Commission_rules {
  id           String   @id @default(cuid())
  role         Roles
  percentage   Float
  fixed_amount Decimal  @db.Decimal(18, 2)
  created_at   DateTime @default(now())
}

model CommissionEarning {
  id                String       @id @default(cuid())
  user_id           String
  period_start      DateTime
  period_end        DateTime
  total_sales       Float
  commission_amount Float
  fines_deducted    Float
  net_pay           Float
  status            SalaryStatus @default(PENDING)
  created_at        DateTime     @default(now())
  user              User         @relation(fields: [user_id], references: [id])
}

model Fine {
  id         String      @id @default(cuid())
  defaulter_id    String
  amount     Float
  reason     String
  issued_by  String
  status     fine_status @default(UNPAID)
  created_at DateTime    @default(now())

  //the admin/supervisor who issued the fine
  issuer      User        @relation("FineIssuer", fields: [issued_by], references: [id])
  //the user who received the fine
  defaulter       User        @relation("FineReceiver", fields: [defaulter_id], references: [id])
}


model Ticketer_Location_Assignment {
  id           String    @id @default(cuid())

  user_id      String
  location_id  String

  assigned_for DateTime

  created_at   DateTime  @default(now())

  user         User      @relation(fields: [user_id], references: [id])
  location     Location  @relation(fields: [location_id], references: [id])

  @@unique([location_id, assigned_for])
}

model Location {
  id            String        @id @default(cuid())
  name          String
  address       String
  created_at    DateTime      @default(now())
  sales_reports SalesReport[]
  ticket_assignments Ticketer_Location_Assignment[]
}


enum AuditAction {
  CREATE
  UPDATE
  DELETE
  VERIFY
  REVERSE
  CANCELLED
}

enum TopUpSource {
  COMPANY_RESERVE
  GOVERNMENT_TOP_UP
  EXTERNAL_OTHER_SOURCE
}

enum AuditEntityType {
  TOPUP
  FLOAT_ALLOCATION
  REMITTANCE
  USER
  FINE
}


enum AccountType {
  COMPANY
  TICKETER
  POS_DEVICE
  SUPERVISOR
}

enum Entry_Type {
  DEBIT
  CREDIT
}

enum fine_status {
  UNPAID
  PAID
  WAIVED
}

enum Roles {
  TICKETER
  SUPERVISOR
  ADMIN
  AUDITOR
}

enum Device_Status {
  ACTIVE
  INACTIVE
  MAINTENANCE
}

enum Remittance_Method {
  CASH
  TRANSFER
}

enum RemittanceStatus {
  PENDING
  CONFIRMED
  REJECTED
  CANCELLED
}

enum SalaryStatus {
  PENDING
  PAID
}

enum Float_Status {
  SUCCESS
  ADJUSTED
  CANCELLED
}

enum TopUpStatus {
  AVAILABLE
  USED
  CANCELLED
}

enum Assignment_Status {
  ACTIVE
  RETURNED
}

enum ReconciliationScope {
  TICKETER 
  SUPERVISOR 
  ORG
}

enum ReconciliationStatus {
  MATCHED       
  VARIANCE       
  PENDING        
  INVESTIGATING  
  RESOLVED      
}

enum ExpectationStatus {
  PENDING
  SUBMITTED
  OVERDUE
  VIOLATED
  PAID
}